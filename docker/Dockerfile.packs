# Pack pipeline image (tools/packs). The pipeline arrives with Feature 2;
# this image is wired into compose from day one so the `packs` profile works
# as soon as the code lands.
FROM python:3.12-slim
WORKDIR /pipeline
COPY tools/packs/ .
RUN pip install --no-cache-dir -e . || echo "pipeline not implemented yet (Feature 2)"
CMD ["python", "-m", "packs", "--out", "/out"]