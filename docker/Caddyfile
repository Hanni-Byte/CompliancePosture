# SITE_ADDRESS: ":80" locally / in compose; the Hetzner deploy overrides it to
# complianceposture.hannibyte.com for auto-TLS (Feature 7).
{$SITE_ADDRESS::80} {
	root * /srv
	encode gzip zstd

	header {
		# CSP is generated at build time from the provider registry
		# (app/scripts/generate-csp.mjs → /etc/caddy/csp.caddy; constitution §8).
		import /etc/caddy/csp.caddy
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Embedder-Policy "require-corp"
		Cross-Origin-Resource-Policy "same-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		-Server
	}

	# Long-cache immutable hashed assets; short-cache pack manifests.
	@immutable path /assets/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"
	@packs path /packs/*
	header @packs Cache-Control "public, max-age=300"

	# Privacy promise: we don't even log your IP. Access logs stay disabled
	# (Caddy's default when no `log` directive is configured). Do not add one.

	# SPA fallback
	try_files {path} /index.html
	file_server
}