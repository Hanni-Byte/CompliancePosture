{
  "name": "complianceposture",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "vite --host",
    "generate:csp": "tsx scripts/generate-csp.ts",
    "build": "npm run generate:csp && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts e2e",
    "depcruise": "depcruise src",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "check": "npm run typecheck && npm run lint && npm run depcruise && npm run test && npm run packs:check:offline && npm run smoke",
    "e2e": "playwright test",
    "packs:check": "tsx scripts/check-packs.ts",
    "packs:check:offline": "tsx scripts/check-packs.ts --offline",
    "smoke:live": "tsx scripts/live-smoke.mjs"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^10.10.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  }
}
